# =============================================================================
# CIPA — .gitignore
# =============================================================================
# Sections:
#   1. Datasets (raw data, never versioned)
#   2. Python bytecode and caches
#   3. Build and packaging artifacts
#   4. Test and coverage artifacts
#   5. Linter and formatter caches
#   6. Experiment output files
#   7. IDE and editor files
#   8. OS-generated files
#   9. Claude Code internal files
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Datasets — raw data files (2.5 GB, third-party licences)
#    The full datasets/ directory is excluded. Users must download
#    each dataset independently; see datasets/README.md for instructions.
# -----------------------------------------------------------------------------
datasets/

# Safety net: block individual data formats even outside datasets/
*.csv
*.mat
*.npy
*.npz
*.h5
*.hdf5
*.parquet
*.feather
*.arrow
*.pkl
*.pickle


# -----------------------------------------------------------------------------
# 2. Python bytecode and import caches
#    Generated automatically by the interpreter; machine- and
#    version-specific, never useful to track.
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo


# -----------------------------------------------------------------------------
# 3. Build and packaging artifacts
#    Produced by `pip install -e .` or `python -m build`.
#    The egg-info directory under src/ is created by setuptools during
#    the editable install and reflects the local environment.
# -----------------------------------------------------------------------------
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/


# -----------------------------------------------------------------------------
# 4. Test and coverage artifacts
#    .coverage      — binary database written by pytest-cov after each run
#    htmlcov/       — HTML coverage report (`--cov-report=html`)
#    .pytest_cache/ — pytest's own cache (last-failed list, node ids, etc.)
#    coverage.xml   — XML coverage report for CI integrations
# -----------------------------------------------------------------------------
.coverage
.coverage.*
htmlcov/
.pytest_cache/
coverage.xml


# -----------------------------------------------------------------------------
# 5. Linter and formatter caches
#    .ruff_cache/   — ruff stores its analysis cache here for speed
#    .mypy_cache/   — type-checker cache (not currently used but common)
# -----------------------------------------------------------------------------
.ruff_cache/
.mypy_cache/


# -----------------------------------------------------------------------------
# 6. Experiment output files
#    The JSON result files in experiments/ are generated by
#    validate_table2.py and are machine-specific snapshots.
#    The canonical results are documented in experiments/VALIDATION_REPORT.md,
#    which IS tracked.
# -----------------------------------------------------------------------------
experiments/results*.json


# -----------------------------------------------------------------------------
# 7. IDE and editor files
#    .vscode/    — VS Code workspace settings (machine-specific)
#    .idea/      — JetBrains / PyCharm project files
#    *.swp/swo   — Vim swap files
#    *~          — Emacs/general backup files
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~


# -----------------------------------------------------------------------------
# 8. OS-generated files
#    .DS_Store   — macOS Finder metadata
#    Thumbs.db   — Windows Explorer thumbnail cache
#    desktop.ini — Windows folder configuration
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
